# Copie este arquivo para .env e preencha com valores reais (nunca comite o .env).
# Descrição completa de cada variável em ENVIRONMENT.md

# --- Sistema IS (somente leitura) ---
SISTEMA_IS_DB_HOST=
SISTEMA_IS_DB_PORT=5432
SISTEMA_IS_DB_NAME=
SISTEMA_IS_DB_USER=
SISTEMA_IS_DB_PASSWORD=
SISTEMA_IS_DB_SSL=true
SISTEMA_IS_DB_SCHEMA=public

# --- e-SUS PEC (somente leitura) ---
ESUS_PEC_DB_HOST=
ESUS_PEC_DB_PORT=5432
ESUS_PEC_DB_NAME=
ESUS_PEC_DB_USER=
ESUS_PEC_DB_PASSWORD=
ESUS_PEC_DB_SSL=true
ESUS_PEC_DB_SCHEMA=public

# --- Banco de controle (próprio) --- URL única, exigida pelo Prisma CLI
# Exemplo local: postgresql://redeis:redeis@localhost:5432/redeis_control
CONTROL_DATABASE_URL=

# --- Autenticação ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY=

SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
WHATSAPP_PROVIDER=meta-cloud-api
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# --- Aplicação / infraestrutura ---
NODE_ENV=development
API_PORT=3000
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
SENTRY_DSN=
