{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.22.0"
    },
    "demo-development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_TENANT_SLUG": "demo",
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:3000"
      }
    },
    "demo-production": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_TENANT_SLUG": "demo",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.demo.redeis.app"
      }
    },
    "demo-preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_TENANT_SLUG": "demo",
        "EXPO_PUBLIC_API_BASE_URL": "SUBSTITUA_PELA_URL_PUBLICA_DA_API"
      }
    },
    "rede-is-development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_TENANT_SLUG": "rede-is",
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:3000"
      }
    },
    "rede-is-production": {
      "extends": "base",
      "android": {
        "credentialsSource": "local"
      },
      "env": {
        "EXPO_PUBLIC_TENANT_SLUG": "rede-is",
        "EXPO_PUBLIC_API_BASE_URL": "TODO: URL de producao da API para este cliente"
      }
    },
    "rede-is-preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_TENANT_SLUG": "rede-is",
        "EXPO_PUBLIC_API_BASE_URL": "TODO: URL publica de homologacao da API para este cliente"
      }
    }
  },
  "submit": {
    "demo-production": {
      "ios": {
        "appleId": "TODO: e-mail da conta Apple Developer do cliente",
        "ascAppId": "TODO: App Store Connect App ID do cliente",
        "appleTeamId": "TODO: Team ID da conta Apple Developer do cliente"
      },
      "android": {
        "serviceAccountKeyPath": "TODO: caminho do JSON da service account do Google Play do cliente",
        "track": "internal"
      }
    },
    "rede-is-production": {
      "android": {
        "serviceAccountKeyPath": "TODO: caminho do JSON da service account do Google Play do cliente (conta que publica o Zera Fila)",
        "track": "production"
      }
    }
  }
}
