{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "base": {
      "node": "20.x"
    },
    "demo-development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_TENANT_SLUG": "demo",
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:3000"
      }
    },
    "demo-production": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_TENANT_SLUG": "demo",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.demo.redeis.app"
      }
    }
  },
  "submit": {
    "demo-production": {
      "ios": {
        "appleId": "TODO: e-mail da conta Apple Developer do cliente",
        "ascAppId": "TODO: App Store Connect App ID do cliente",
        "appleTeamId": "TODO: Team ID da conta Apple Developer do cliente"
      },
      "android": {
        "serviceAccountKeyPath": "TODO: caminho do JSON da service account do Google Play do cliente",
        "track": "internal"
      }
    }
  }
}
